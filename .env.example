DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
PORT=3000

PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
PUBLIC_BASE_URL=http://localhost:3000

# ALLOW_SIMULATED_PAYMENTS=true
# Note: ALLOW_SIMULATED_PAYMENTS only works outside production (NODE_ENV !== "production") and only for development.

# Note: .env.test must point at a separate Neon database branch, never production, because tests perform destructive table wipes between runs.
